<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lateraroot" x:Class="Lateraroot.SettingsWindow" Title="Lateraroot — 設定" Width="960" Height="790" MinWidth="760" MinHeight="560" Style="{StaticResource {x:Type Window}}" Background="#F5F5F7" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <local:ColorInkConverter x:Key="ColorInk"/>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBody" Margin="0,0,8,0" CornerRadius="12" Padding="18,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBody" Property="Background" Value="#171717"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBody" Property="BorderBrush" Value="#8E8E93"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GenreItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="White"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E9E9ED"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#171717"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Outline" BorderBrush="#CCCCD0" BorderThickness="1" CornerRadius="12"/>
                            <Border Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="8" Margin="6"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="Outline" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="LATERAROOT / PREFERENCES" FontSize="10" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="自分のデスクトップに。" FontSize="25" Margin="0,8,0,6"/>
            <TextBlock Text="ジャンルを選んで、名前・色・分類を決めます。変更は「保存する」で反映されます。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0">
            <TabItem Header="ジャンルと色">
                <Grid Margin="0,18,0,0" TextElement.Foreground="{StaticResource Ink}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ジャンル一覧 · 上から順に分類" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,0,0,12"/>
                        <ListBox x:Name="RulesList" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource GenreItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GenreSelected" AutomationProperties.Name="編集するジャンル">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" Background="{Binding Color}" BorderBrush="#BBBBBF" BorderThickness="1" CornerRadius="7" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                            <TextBlock Text="{Binding Color}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="AddButton" Grid.Row="2" Content="＋ ジャンルを追加" Click="AddRule" HorizontalAlignment="Stretch" Margin="0,12,0,8"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UpButton" Content="↑ 上へ" Click="MoveUp" Margin="0,0,6,0" ToolTip="分類の優先順位を上げる"/>
                            <Button x:Name="DownButton" Grid.Column="1" Content="↓ 下へ" Click="MoveDown" Margin="0,0,6,0"/>
                            <Button x:Name="RemoveButton" Grid.Column="2" Content="削除" Click="RemoveRule" ToolTip="未分類用のジャンルは残します"/>
                        </Grid>
                    </Grid>
                    <Border Grid.Column="2" Background="White" CornerRadius="20" Padding="24,20">
                        <ScrollViewer x:Name="GenreScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <StackPanel Margin="0,0,18,0">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="116"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="ジャンル名" Margin="0,2,0,8"/>
                                        <TextBox x:Name="NameBox" MaxLength="24" Text="{Binding SelectedItem.Name, ElementName=RulesList, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ジャンル名"/>
                                        <TextBlock Text="24文字まで。ファイルは移動せず再分類します。" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <local:GlassSurface x:Name="SquarePreview" Grid.Column="1" Width="104" Height="104" HorizontalAlignment="Right" Background="{Binding SelectedItem.Color,ElementName=RulesList}">
                                        <Grid Margin="14" TextElement.Foreground="{Binding SelectedItem.Color,ElementName=RulesList,Converter={StaticResource ColorInk}}">
                                            <TextBlock Text="PREVIEW" FontSize="9"/>
                                            <TextBlock x:Name="PreviewName" Text="{Binding SelectedItem.Name,ElementName=RulesList}" TextWrapping="Wrap" MaxHeight="40" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Text="00" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </local:GlassSurface>
                                </Grid>
                                <DockPanel Margin="0,2,0,8">
                                    <Button x:Name="ResetPaletteButton" Content="全色を白・黒に戻す" Click="ResetColors" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" Padding="0" FontSize="11" ToolTip="ジャンル名と分類ルールを保ち、すべての色を白・黒に戻します"/>
                                    <TextBlock Text="ガラスの色"/>
                                </DockPanel>
                                <WrapPanel x:Name="PalettePanel">
                                    <Button Style="{StaticResource Swatch}" Tag="#FFFFFF" Click="ChooseSwatch" ToolTip="白" AutomationProperties.Name="白"/>
                                    <Button Style="{StaticResource Swatch}" Tag="#000000" Click="ChooseSwatch" ToolTip="黒" AutomationProperties.Name="黒"/>
                                    <Button Style="{StaticResource Swatch}" Tag="#A8BEDF" Click="ChooseSwatch" ToolTip="ブルー" AutomationProperties.Name="ブルー"/>
                                    <Button Style="{StaticResource Swatch}" Tag="#B4C6B2" Click="ChooseSwatch" ToolTip="セージ" AutomationProperties.Name="セージ"/>
                                    <Button Style="{StaticResource Swatch}" Tag="#D4BEDD" Click="ChooseSwatch" ToolTip="ラベンダー" AutomationProperties.Name="ラベンダー"/>
                                    <Button Style="{StaticResource Swatch}" Tag="#E0B9B8" Click="ChooseSwatch" ToolTip="ローズ" AutomationProperties.Name="ローズ"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="ほかの色を選ぶ…" Click="ChooseCustomColor" Margin="0,0,12,0"/>
                                    <TextBox x:Name="ColorBox" Width="112" MaxLength="7" TextChanged="ColorEdited" AutomationProperties.Name="カラーコード #RRGGBB" ToolTip="#RRGGBB形式でも入力できます"/>
                                </WrapPanel>
                                <TextBlock x:Name="ColorError" Foreground="#A32626" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="白・黒を標準に、好きな色を選べます。文字色は自動で調整します。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,16"/>
                                <TextBlock Text="このジャンルに表示するもの" Margin="0,0,0,8"/>
                                <ComboBox x:Name="KindBox" SelectionChanged="KindChanged" AutomationProperties.Name="分類方法">
                                    <ComboBoxItem Content="拡張子を指定"/>
                                    <ComboBoxItem Content="フォルダー"/>
                                    <ComboBoxItem Content="その他 · 未分類のファイル"/>
                                </ComboBox>
                                <TextBox x:Name="FilterBox" Margin="0,10,0,0" Text="{Binding SelectedItem.Filter,ElementName=RulesList,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="拡張子の分類ルール"/>
                                <TextBlock x:Name="FilterHint" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="配置と動作">
                <Border Background="White" CornerRadius="20" Padding="28,20" Margin="0,18,0,0" TextElement.Foreground="{StaticResource Ink}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="175"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="画面の端" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="EdgeBox" AutomationProperties.Name="画面の端">
                                        <ComboBoxItem Content="右端"/>
                                        <ComboBoxItem Content="左端"/>
                                        <ComboBoxItem Content="上端"/>
                                        <ComboBoxItem Content="下端"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="ディスプレイ" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="ディスプレイ"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="閉じるまでの時間" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="DelayBox" AutomationProperties.Name="閉じるまでの時間">
                                        <ComboBoxItem Content="0.3 秒" Tag="300"/>
                                        <ComboBoxItem Content="0.5 秒" Tag="500"/>
                                        <ComboBoxItem Content="0.8 秒" Tag="800"/>
                                        <ComboBoxItem Content="1.2 秒" Tag="1200"/>
                                        <ComboBoxItem Content="2 秒" Tag="2000"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="正方形のサイズ" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="SizeBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SizePreviewChanged" AutomationProperties.Name="正方形のサイズ"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="端に沿った位置" Margin="0,0,0,16"/>
                                    <Slider x:Name="OffsetBox" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutoToolTipPlacement="BottomRight" AutomationProperties.Name="端に沿った位置"/>
                                    <TextBlock Text="上・左 ← → 下・右" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="LockPositionBox" Content="配置をロック（ドラッグ移動を無効にする）"/>
                            <TextBlock Text="画面の端・ディスプレイ・位置は、この設定画面から変更できます。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <TextBlock Text="見た目とアクセシビリティ" FontSize="16" Margin="0,0,0,8"/>
                            <CheckBox x:Name="TransparencyBox" Content="透明効果を減らす" Checked="TransparencyChanged" Unchecked="TransparencyChanged"/>
                            <TextBlock Text="ガラスを不透明にして読みやすくします。Windowsのハイコントラスト設定にも従います。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ReduceMotionBox" Content="動きを減らす" ToolTip="Windowsのアニメーション設定にも自動で従います"/>
                            <Separator Margin="0,16"/>
                            <CheckBox x:Name="PublicBox" Content="共有デスクトップも表示する（移動しません）"/>
                            <CheckBox x:Name="StartupBox" Content="サインイン時に起動する"/>
                            <CheckBox x:Name="UpdatesBox" Content="新しいバージョンを自動で確認する" ToolTip="起動時と1日ごとにGitHubへ確認します。ダウンロードと適用は手動です。"/>
                            <Button Content="ジャンルと分類を標準に戻す" Click="ResetRules" HorizontalAlignment="Left" Margin="0,16,0,0" ToolTip="編集中のジャンル・色・分類を標準に戻します。保存前ならキャンセルできます。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="SaveError" Grid.Row="2" Foreground="#A32626" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SandboxLabel" FontSize="10" Foreground="{StaticResource Muted}"/>
                <WrapPanel>
                    <Button Content="更新を確認 ↗" Click="OpenUpdates" Padding="0,7" Background="Transparent" FontSize="11" Margin="0,0,16,0"/>
                    <Button Content="収納フォルダー ↗" Click="OpenStorage" Padding="0,7" Background="Transparent" FontSize="11"/>
                </WrapPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="キャンセル" IsCancel="True" Padding="20,10" Margin="8,0"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="保存する" Click="SaveSettings" IsDefault="True" Padding="24,10" Background="#171717" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
