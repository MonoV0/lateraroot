<Window x:Class="Lateraroot.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lateraroot — アップデート" Style="{StaticResource {x:Type Window}}" Width="540" Height="510" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False">
 <Grid Margin="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="LATERAROOT / UPDATE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,12"/><TextBlock Text="アップデート" FontSize="24"/><TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,28,0,16"><TextBlock x:Name="UpdateTitle" FontSize="16" TextWrapping="Wrap"/><TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,16,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="更新のダウンロード状況"/></StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/></ScrollViewer>
  <TextBlock x:Name="InstallHint" Grid.Row="3" Text="ダウンロード後、更新して再起動できます。設定と収納済みファイルは引き継がれます。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,16,0,20"/>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="リリースページ ↗" Click="OpenReleases" Background="Transparent" BorderThickness="0" Padding="0,8" HorizontalAlignment="Left" FontSize="11"/><Button x:Name="DismissButton" Grid.Column="1" Content="閉じる" Click="Dismiss" Margin="8,0"/><Button x:Name="UpdateAction" Grid.Column="2" Content="更新を確認" Click="Act" Foreground="White" Background="#171717" MinWidth="120"/></Grid>
 </Grid>
</Window>
