<Window x:Class="Lateraroot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lateraroot"
        Style="{StaticResource {x:Type Window}}" Width="68" Height="620" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        MouseEnter="WindowEnter" MouseLeave="WindowLeave" PreviewKeyDown="WindowKeyDown">
    <Border Background="#171B26" BorderBrush="#343B50" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid x:Name="LayoutRoot">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="PanelColumn" Width="0" /><ColumnDefinition x:Name="RailColumn" Width="66" /></Grid.ColumnDefinitions>
            <Grid x:Name="Panel" Grid.Column="0" Margin="22,22,20,18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PinButton" Content="○" ToolTip="開いたままにする" AutomationProperties.Name="開いたままにする" Click="TogglePin" Padding="9,4" Margin="0,0,6,0" />
                        <Button Content="×" ToolTip="閉じる (Esc)" AutomationProperties.Name="パネルを閉じる" Click="ClosePanel" Background="Transparent" Padding="9,4" />
                    </StackPanel>
                    <StackPanel><TextBlock Text="lateraroot" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="A QUIET HOME FOR YOUR DESKTOP" FontSize="8" Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,17">
                    <StackPanel><TextBlock x:Name="StackTitle" Text="ドキュメント" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="StackSubtitle" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="このスタックを検索" AutomationProperties.Name="ファイルを検索" Margin="0,0,8,0" />
                    <TextBlock x:Name="SearchHint" Text="⌕  ファイルを検索" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <ComboBox x:Name="OrderBox" Grid.Column="1" SelectionChanged="OrderChanged" AutomationProperties.Name="並び順">
                        <ComboBoxItem Content="名前順" /><ComboBoxItem Content="更新が新しい順" /><ComboBoxItem Content="種類順" /><ComboBoxItem Content="サイズ順" />
                    </ComboBox>
                </Grid>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Grid>
                        <ItemsControl x:Name="FileItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="112" Height="110" Margin="0,0,5,7" Padding="8" Background="#202633" Click="OpenFile" Tag="{Binding Item}" ToolTip="{Binding Tooltip}">
                                    <Button.ContextMenu><ContextMenu Opened="FileMenuOpened" Closed="FileMenuClosed">
                                        <MenuItem Header="エクスプローラーで表示" Click="RevealFile" />
                                        <MenuItem Header="元の場所へ戻す" Click="RestoreFile" />
                                    </ContextMenu></Button.ContextMenu>
                                    <StackPanel Width="94">
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,2,0,10" />
                                        <TextBlock Text="{Binding Item.Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="12" />
                                        <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="10,40">
                            <TextBlock Text="◇" FontSize="38" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="ここは、まだ静かです。" HorizontalAlignment="Center" Margin="0,16,0,8" FontSize="16" />
                            <TextBlock x:Name="EmptyDescription" Text="デスクトップに対象のファイルを置くと表示されます。" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Border Grid.Row="4" BorderBrush="#30374A" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="OrganizeButton" Content="↓  デスクトップを整理" Click="OrganizeDesktop" Foreground="#171B26" Background="#BCB0FF" Padding="12,10" />
                        <Button x:Name="RestoreButton" Grid.Column="1" Content="元に戻す" Click="RestoreStack" Margin="8,0,0,0" ToolTip="このスタックの収納済みファイルを戻します" />
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Row="5" Text="ホバーで開く · 離れると閉じる" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </Grid>
            <Border x:Name="Rail" Grid.Column="1" Background="#121620" CornerRadius="15" Padding="7,13,7,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="lr." Foreground="{StaticResource Accent}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" />
                    <Button DockPanel.Dock="Bottom" Content="⚙" FontSize="19" Padding="8" Background="Transparent" ToolTip="設定" AutomationProperties.Name="設定" Click="ShowSettings" Margin="0,8,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="StackRail" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
