<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Lateraroot.MainWindow" Title="Lateraroot" Style="{StaticResource {x:Type Window}}" Width="68" Height="620" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" MouseEnter="WindowEnter" MouseLeave="WindowLeave" PreviewKeyDown="WindowKeyDown">
    <Border x:Name="Frame" Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="*"/>
                <RowDefinition x:Name="SecondRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PanelColumn" Width="0"/>
                <ColumnDefinition x:Name="RailColumn" Width="66"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="Panel" Grid.Column="0" Margin="18" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel x:Name="PanelHeader" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ExpandAllButton" Content="↙ OPEN" Click="ToggleAllFiles" Padding="10,4" BorderThickness="0" Background="Transparent" Visibility="Collapsed"/>
                        <Button x:Name="PinButton" Content="○" ToolTip="開いたままにする" AutomationProperties.Name="開いたままにする" Click="TogglePin" Padding="8,4" BorderThickness="0" Background="Transparent"/>
                        <Button Content="×" ToolTip="閉じる (Esc)" AutomationProperties.Name="パネルを閉じる" Click="ClosePanel" Background="Transparent" BorderThickness="0" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="StackTitle" FontSize="20"/>
                        <TextBlock x:Name="StackSubtitle" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid x:Name="SearchTools" Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="ファイルを検索" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SearchHint" Text="ファイルを検索" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <ComboBox x:Name="OrderBox" Grid.Column="1" SelectionChanged="OrderChanged" AutomationProperties.Name="並び順">
                        <ComboBoxItem Content="名前順"/>
                        <ComboBoxItem Content="更新が新しい順"/>
                        <ComboBoxItem Content="種類順"/>
                        <ComboBoxItem Content="サイズ順"/>
                    </ComboBox>
                </Grid>
                <ScrollViewer x:Name="FileScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Grid>
                        <ItemsControl x:Name="FileItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="100" Height="96" Padding="6" BorderBrush="#40FFFFFF" BorderThickness="0,0,1,1" Background="{Binding Background}" Click="OpenFile" Tag="{Binding Item}" ToolTip="{Binding Tooltip}">
                                        <Button.ContextMenu>
                                            <ContextMenu Opened="FileMenuOpened" Closed="FileMenuClosed">
                                                <MenuItem Header="エクスプローラーで表示" Click="RevealFile"/>
                                                <MenuItem Header="元の場所へ戻す" Click="RestoreFile"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Width="88">
                                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,1,0,9"/>
                                            <TextBlock Text="{Binding Item.Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="11"/>
                                            <TextBlock Text="{Binding Caption}" FontSize="9" TextAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="10,18">
                            <TextBlock x:Name="EmptyTitle" Text="ファイルはありません" HorizontalAlignment="Center" FontSize="14"/>
                            <TextBlock x:Name="EmptyDescription" Text="分類ルールは設定から変更できます。" Foreground="{StaticResource Muted}" TextAlignment="Center" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Border x:Name="Footer" Grid.Row="3" BorderBrush="#D4D4D4" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OrganizeButton" Content="デスクトップを整理 ↙" Click="OrganizeDesktop" Foreground="White" Background="#171717"/>
                        <Button x:Name="RestoreButton" Grid.Column="1" Content="元に戻す" Click="RestoreStack" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </Grid>
            <Border x:Name="Rail" Grid.Column="1" Background="White">
                <DockPanel x:Name="RailLayout">
                    <StackPanel x:Name="RailHeader" DockPanel.Dock="Top">
                        <Thumb x:Name="DragHandle" Height="22" Cursor="SizeAll" DragStarted="DockDragStarted" DragDelta="DockDragDelta" DragCompleted="DockDragCompleted" ToolTip="ドラッグして画面端に沿って移動">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="White">
                                        <TextBlock Text="⋮⋮" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <TextBlock Text="lr." FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    </StackPanel>
                    <StackPanel x:Name="RailActions" DockPanel.Dock="Bottom">
                        <Button Content="設定" FontSize="10" BorderThickness="0" Padding="4,8" Click="ShowSettings"/>
                        <Button Content="−" ToolTip="最小化" AutomationProperties.Name="最小化" BorderThickness="0" Padding="4,6" Click="MinimizeDock"/>
                        <Button Content="×" ToolTip="非表示（通知領域から戻せます）" AutomationProperties.Name="非表示" BorderThickness="0" Padding="4,6" Click="HideDock"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="StackRail"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid x:Name="MinimizedTab" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MiniFirstRow" Height="20"/>
                    <RowDefinition x:Name="MiniSecondRow" Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MiniFirstCol" Width="*"/>
                    <ColumnDefinition x:Name="MiniSecondCol" Width="0"/>
                </Grid.ColumnDefinitions>
                <Thumb Cursor="SizeAll" DragStarted="DockDragStarted" DragDelta="DockDragDelta" DragCompleted="DockDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="White">
                                <TextBlock Text="⋮⋮" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Button x:Name="MiniRestore" Grid.Row="1" Content="↗" ToolTip="Lateraroot を戻す" AutomationProperties.Name="Lateraroot を戻す" BorderThickness="0" Padding="0" Click="RestoreDockClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
