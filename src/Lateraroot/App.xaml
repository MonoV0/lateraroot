<?xml version="1.0" ?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lateraroot" x:Class="Lateraroot.App" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Generated/FlaticonIcons.xaml"/></ResourceDictionary.MergedDictionaries>
        <FontFamily x:Key="MainFont">pack://application:,,,/Lateraroot;component/Assets/Fonts/#Zen Kaku Gothic New</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#171717"/>
        <SolidColorBrush x:Key="Muted" Color="#686868"/>
        <SolidColorBrush x:Key="Accent" Color="#171717"/>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="local:WidgetMotion.Hover" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <local:GlassSurface x:Name="Body" Inset="0" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverInk" CornerRadius="10" Margin="1" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="HoverLine" CornerRadius="10" Margin="1" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:StateLayerConverter x:Key="StateLayer"/>
        <ControlTemplate x:Key="DockHeaderTemplate" TargetType="Thumb">
            <Grid Background="Transparent">
                <local:GlassSurface Background="White" CornerRadius="16"/>
                <Border x:Name="HoverInk" CornerRadius="15" Margin="3" Background="#171717" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="HoverLine" CornerRadius="15" Margin="3" BorderBrush="#171717" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                <Grid Margin="10,10,10,9" IsHitTestVisible="False">
                    <local:UiIcon x:Name="Glyph" Kind="GripIcon" Width="18" Height="10" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="#666666"/>
                    <TextBlock Text="lr." FontSize="18" VerticalAlignment="Bottom" HorizontalAlignment="Center" Foreground="#171717"/>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Glyph" Property="Kind" Value="LockIcon"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="CompactGripTemplate" TargetType="Thumb">
            <Grid Background="Transparent">
                <Border x:Name="HoverInk" CornerRadius="7" Margin="2" Background="#171717" Opacity="0" IsHitTestVisible="False"/>
                <Border x:Name="HoverLine" CornerRadius="7" Margin="2" BorderBrush="#171717" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                <local:UiIcon x:Name="Glyph" Kind="GripIcon" Width="16" Height="8" Foreground="#666666"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Glyph" Property="Kind" Value="LockIcon"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SquareButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <local:GlassSurface Background="{TemplateBinding Background}" IsHitTestVisible="False"/>
                            <Border x:Name="HoverInk" Margin="3" CornerRadius="15" Background="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateLayer}}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter/>
                            <Border x:Name="HoverLine" Margin="3" CornerRadius="15" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="FocusRing" Margin="4" CornerRadius="14" BorderBrush="Transparent" BorderThickness="2" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#BFD5ED"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#171717"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="MaxWidth" Value="400"/>
        </Style>
            </ResourceDictionary>
    </Application.Resources>
</Application>
