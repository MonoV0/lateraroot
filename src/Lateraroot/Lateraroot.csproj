<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(PreviewBuild)' == 'true'">$(DefineConstants);GLASS_PREVIEW</DefineConstants>
    <Version>0.8.1</Version>
    <StartupObject>Lateraroot.Program</StartupObject>
    <AssemblyName>Lateraroot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lateraroot.Core/Lateraroot.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets/Fonts/ZenKakuGothicNew-Medium.ttf" />
    <Resource Include="Assets/Glass.ps" />
    <Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireUiIcons" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Generated/FlaticonIcons.xaml')" Text="Run ./scripts/Prepare-Icons.ps1 in PowerShell 7 from the repository root before building Lateraroot." />
  </Target>
</Project>
